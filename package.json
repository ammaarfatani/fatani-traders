{
  "name": "fatani-traders-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Mobile-First Textile Trading, Inventory, Sales, Accounting and Business Management ERP",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:shared": "pnpm --filter @fatani/shared build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build": "pnpm run build:shared && pnpm run build:backend && pnpm run build:frontend",
    "test": "pnpm --filter backend test",
    "db:generate": "pnpm --filter backend db:generate",
    "db:push": "pnpm --filter backend db:push",
    "db:seed": "pnpm --filter backend db:seed"
  },
  "keywords": [
    "textile",
    "erp",
    "inventory",
    "accounting",
    "khata",
    "fatani-traders"
  ],
  "author": "Fatani Traders",
  "license": "UNLICENSED"
}
